{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/window_guard.sh",
            "args": [],
            "timeout": 10,
            "statusMessage": "window-guard: checking frozen files"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(uv run --with-requirements requirements.txt --with pytest pytest *)",
      "Bash(uvx ruff check *)",
      "Bash(/usr/bin/python3 -m py_compile *)"
    ]
  }
}
